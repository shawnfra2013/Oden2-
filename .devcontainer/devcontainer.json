{
  "name": "Odin 2 — isolated development workspace",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.13-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff"
      ]
    }
  },
  "portsAttributes": {
    "8765": {
      "onAutoForward": "ignore"
    },
    "8780": {
      "onAutoForward": "ignore"
    },
    "18080": {
      "onAutoForward": "ignore"
    }
  },
  "remoteUser": "vscode"
}
